---
import Layout from "../layouts/Layout.astro";
import MinesweeperBanner from "../components/MinesweeperBanner.astro";
import WindowWithClose from "../components/WindowWithClose.tsx";
import "../styles/index.css";

// Generate the last updated date at build time
const lastUpdated = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long', 
  day: 'numeric'
});
---

<Layout title="Artis Avotins - Personal Page">
  <WindowWithClose client:load>
    <div class="sunken-panel top-panel">
      <div class="top-panel-header">
        <div class="top-panel-icon">
          <span>👤</span>
        </div>
        <div class="top-panel-title">
          <h2>Artis Avotins</h2>
          <div class="top-panel-subtitle">Full Stack Engineer</div>
        </div>
      </div>
      <div class="top-panel-body">
        <div class="sunken-panel top-panel-info">
          <div>
            <strong>Experience:</strong> 20+ years of shipping software<br />
            <strong>Location:</strong> Latvia / Remote<br />
            <strong>Website:</strong> New age fun with a vintage feel<br />
            <strong>Contact:</strong> Send me an email
          </div>
        </div>
        <div
          class="sunken-panel top-panel-image hamster-tile"
          role="button"
          tabindex="0"
          aria-label="Reveal hacker emblem"
        >
          <img src="/hamster-dance.gif" alt="Hamster Dance" />
          <div class="glider-overlay" aria-hidden="true">
            <span class="glider-dot" style="--i: 0; grid-area: 1 / 2;"></span>
            <span class="glider-dot" style="--i: 1; grid-area: 2 / 3;"></span>
            <span class="glider-dot" style="--i: 2; grid-area: 3 / 1;"></span>
            <span class="glider-dot" style="--i: 3; grid-area: 3 / 2;"></span>
            <span class="glider-dot" style="--i: 4; grid-area: 3 / 3;"></span>
          </div>
        </div>
        <script>
          const tile = document.querySelector(".hamster-tile");
          if (tile) {
            const toggle = () => tile.classList.toggle("play");
            tile.addEventListener("click", toggle);
            tile.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                toggle();
              }
            });
          }
        </script>
      </div>
    </div>

    <fieldset class="about-me-fieldset">
      <legend>💬 About Me</legend>
      <div class="sunken-panel about-me-panel">
        <div class="about-me-title">
          👋 Hi, I'm Artis. Welcome to my website!
        </div>
        <div class="about-me-text">
          I'm a full-stack engineer and have been writing software for a
          living since 2004, as a lead engineer, an independent consultant and
          an engineering manager. I like owning things end to end, and I'm at
          my best on problems that cross layers, from native code on small
          devices to what the user sees in the browser. I like making
          expensive things cheap, and I've been building with AI agents
          since 2023.
        </div>
      </div>

      <div class="sunken-panel about-me-panel">
        <div class="experience-interests-title">
          🎯 Off-Screen
        </div>
        <div class="experience-interests-text">
          I'm a father, a hiker, a fisherman, and a petrolhead. My tinkering
          habit is mostly about taking things apart to see how they work:
          flashing custom firmware onto cheap microcontrollers and cameras,
          listening in on Bluetooth sensors around the house, reverse
          engineering old binaries, and making consumer hardware do things it
          wasn't shipped for.
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Skills</legend>
      <ul class="tree-view">
        <li>
          Languages
          <ul>
            <li>TypeScript / JavaScript, Python, C++, Rust, Ruby, SQL</li>
          </ul>
        </li>
        <li>
          Frontend
          <ul>
            <li>React, WebAssembly, Astro</li>
          </ul>
        </li>
        <li>
          Backend
          <ul>
            <li>Node.js, Python (asyncio, FastAPI, Django), Rails</li>
          </ul>
        </li>
        <li>
          Media & Protocols
          <ul>
            <li>WebRTC, MP4, REST, GraphQL, MQTT, BLE, custom TCP</li>
          </ul>
        </li>
        <li>
          Performance
          <ul>
            <li>ARM NEON / SIMD, streaming and incremental processing, on-device benchmarking</li>
          </ul>
        </li>
        <li>
          Data & Infra
          <ul>
            <li>PostgreSQL, Redis, Docker, AWS, GitHub Actions</li>
          </ul>
        </li>
        <li>
          Testing
          <ul>
            <li>Vitest, Jest, Playwright</li>
          </ul>
        </li>
        <li>
          AI
          <ul>
            <li>Agentic coding, LLM pipelines, on-device models</li>
          </ul>
        </li>
        <li>
          Hardware
          <ul>
            <li>ESP32 / ESP-IDF, Arduino, Raspberry Pi</li>
          </ul>
        </li>
      </ul>
    </fieldset>

    <fieldset>
      <legend>Languages</legend>
      <p>Latvian (native), English (C1)</p>
    </fieldset>

    <fieldset>
      <legend>Contact</legend>
      <div class="field-row">
        <a href="mailto:artis.avotins@gmail.com"><button>Send Email</button></a>
        <a href="https://github.com/artis101" target="_blank" rel="noopener noreferrer"><button>GitHub</button></a>
      </div>
    </fieldset>

    <fieldset>
      <legend>Games</legend>
      <div class="games-row">
        <a href="/minesweeper" class="desktop-shortcut" aria-label="Play Minesweeper">
          <MinesweeperBanner />
        </a>
        <p class="games-text">
          I enjoy playing games in my free time. I've built a simple Minesweeper
          you can play right here as a reward for visiting my page.
        </p>
      </div>
    </fieldset>

    <div class="status-bar">
      <p class="status-bar-field">Ready</p>
      <p class="status-bar-field">Last updated: {lastUpdated}</p>
    </div>
  </WindowWithClose>
</Layout>
