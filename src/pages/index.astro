---
import Layout from "../layouts/Layout.astro";
import MinesweeperBanner from "../components/MinesweeperBanner.astro";
import WindowWithClose from "../components/WindowWithClose.tsx";
import "../styles/index.css";

// Generate the last updated date at build time
const lastUpdated = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long', 
  day: 'numeric'
});
---

<Layout title="Artis Avotins - Personal Page">
  <WindowWithClose client:load>
    <div class="sunken-panel top-panel">
      <div class="top-panel-header">
        <div class="top-panel-icon">
          <span>👤</span>
        </div>
        <div class="top-panel-title">
          <h2>Artis Avotins</h2>
          <div class="top-panel-subtitle">Builder & Programmer</div>
        </div>
      </div>
      <div class="top-panel-body">
        <div class="sunken-panel top-panel-info">
          <div>
            <strong>Experience:</strong> Yes<br />
            <strong>Location:</strong> Remote / The EU<br />
            <strong>Website:</strong> New age fun with a vintage feel<br />
            <strong>Contact:</strong> Send me an email
          </div>
        </div>
        <div
          class="sunken-panel top-panel-image hamster-tile"
          role="button"
          tabindex="0"
          aria-label="Reveal hacker emblem"
        >
          <img src="/hamster-dance.gif" alt="Hamster Dance" />
          <div class="glider-overlay" aria-hidden="true">
            <span class="glider-dot" style="--i: 0; grid-area: 1 / 2;"></span>
            <span class="glider-dot" style="--i: 1; grid-area: 2 / 3;"></span>
            <span class="glider-dot" style="--i: 2; grid-area: 3 / 1;"></span>
            <span class="glider-dot" style="--i: 3; grid-area: 3 / 2;"></span>
            <span class="glider-dot" style="--i: 4; grid-area: 3 / 3;"></span>
          </div>
        </div>
        <script>
          const tile = document.querySelector(".hamster-tile");
          if (tile) {
            const toggle = () => tile.classList.toggle("play");
            tile.addEventListener("click", toggle);
            tile.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                toggle();
              }
            });
          }
        </script>
      </div>
    </div>

    <fieldset class="about-me-fieldset">
      <legend>💬 About Me</legend>
      <div class="sunken-panel about-me-panel">
        <div class="about-me-title">
          👋 Hi, I'm Artis. Welcome to my website!
        </div>
        <div class="about-me-text">
          I'm a full-stack software engineer with about two decades of
          experience. I'm comfortable across the whole stack and happy getting
          my hands dirty wherever the work is, backend or frontend. I've
          worked as an individual contributor, engineering manager, and
          consultant, at startups and larger companies. I make extensive use
          of AI tools in my day-to-day work.
        </div>
      </div>

      <div class="sunken-panel about-me-panel">
        <div class="technical-focus-title">
          🛠️ Technical Focus
        </div>
        <div class="technical-focus-text">
          I work primarily in TypeScript across the stack: React on the
          frontend, Node.js and Express on the backend, PostgreSQL for data,
          Docker for dev and deploy. Python is still very much in the toolbox
          too, with Django and FastAPI for services, plus plenty of scripting
          and side projects. I'm comfortable dropping into protocols (WebRTC,
          MQTT, custom TCP) and wiring third-party integrations end-to-end,
          across schema, service, and UI. I use AI tools daily and treat them
          as a core part of my workflow. Linux at heart; macOS and Arch
          day-to-day.
        </div>
      </div>

      <div class="sunken-panel about-me-panel">
        <div class="experience-interests-title">
          🎯 Off-Screen
        </div>
        <div class="experience-interests-text">
          I'm a father, a hiker, a fisherman, and a petrolhead. I tinker with
          hardware (Arduino, Raspberry Pi, ESP32) and build small robots with
          Lego Technic. I also like making consumer hardware do things it
          wasn't shipped for: LED animations on network gear, custom sprites
          on device screens, writing mocks of obscure protocols to test
          against.
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Skills</legend>
      <ul class="tree-view">
        <li>
          Languages
          <ul>
            <li>TypeScript / JavaScript, Python, SQL</li>
          </ul>
        </li>
        <li>
          Frontend
          <ul>
            <li>React, Astro</li>
          </ul>
        </li>
        <li>
          Backend
          <ul>
            <li>Node.js, Express, Django, FastAPI</li>
          </ul>
        </li>
        <li>
          APIs & Protocols
          <ul>
            <li>REST, GraphQL, WebRTC, MQTT, TCP</li>
          </ul>
        </li>
        <li>
          Databases
          <ul>
            <li>PostgreSQL, Redis</li>
          </ul>
        </li>
        <li>
          Cloud & DevOps
          <ul>
            <li>AWS, Docker, GitHub Actions</li>
          </ul>
        </li>
        <li>
          Testing
          <ul>
            <li>Vitest, Jest, Mocha, Playwright</li>
          </ul>
        </li>
        <li>
          Hardware tinkering
          <ul>
            <li>Arduino, Raspberry Pi, ESP32</li>
          </ul>
        </li>
        <li>
          Hardware hacks
          <ul>
            <li>LED animations, custom screens, protocol mocks</li>
          </ul>
        </li>
      </ul>
    </fieldset>

    <fieldset>
      <legend>Contact</legend>
      <div class="field-row">
        <a href="mailto:artis.avotins@gmail.com"><button>Send Email</button></a>
        <a href="https://github.com/artis101" target="_blank" rel="noopener noreferrer"><button>GitHub</button></a>
      </div>
    </fieldset>

    <fieldset>
      <legend>Games</legend>
      <div class="games-row">
        <a href="/minesweeper" class="desktop-shortcut" aria-label="Play Minesweeper">
          <MinesweeperBanner />
        </a>
        <p class="games-text">
          I enjoy playing games in my free time. I've built a simple Minesweeper
          you can play right here as a reward for visiting my page.
        </p>
      </div>
    </fieldset>

    <div class="status-bar">
      <p class="status-bar-field">Ready</p>
      <p class="status-bar-field">Last updated: {lastUpdated}</p>
    </div>
  </WindowWithClose>
</Layout>
